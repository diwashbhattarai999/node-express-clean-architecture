{
	"name": "node-express-clean-architecture",
	"version": "1.1.1",
	"description": "Production-grade Node.js + Express starter template following Clean Architecture principles.",
	"main": "index.js",
	"scripts": {
		"dev": "tsx watch src/server.ts",
		"build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json --resolve-full-paths",
		"start": "node dist/server.js",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"format": "biome format --write .",
		"format:check": "biome format . --write=false",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"prepare": "lefthook install",
		"db:up": "docker compose up -d postgres",
		"db:down": "docker compose down",
		"db:reset": "docker compose down -v && docker compose up -d postgres",
		"db:logs": "docker compose logs -f postgres",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"docker:build": "docker compose build api",
		"docker:up": "docker compose up -d --build",
		"docker:down": "docker compose down",
		"docker:logs": "docker compose logs -f api",
		"docker:reset": "docker compose down -v && docker compose up -d --build"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"packageManager": "pnpm@11.22.0",
	"engines": {
		"node": ">=22"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "11.22.0",
			"onFail": "download"
		}
	},
	"type": "module",
	"devDependencies": {
		"@biomejs/biome": "^2.5.14",
		"@commitlint/cli": "^21.2.2",
		"@commitlint/config-conventional": "^21.2.2",
		"@commitlint/types": "^21.2.0",
		"@types/compression": "^1.8.1",
		"@types/cookie-parser": "^1.4.10",
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.6",
		"@types/multer": "^2.3.0",
		"@types/node": "^26.6.5",
		"@types/supertest": "^7.2.1",
		"@vitest/coverage-v8": "^4.1.11",
		"drizzle-kit": "^0.31.10",
		"lefthook": "^2.2.2",
		"pino-pretty": "^13.1.3",
		"tsc-alias": "^1.9.5",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2",
		"vitest": "^4.1.11"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1156.0",
		"@aws-sdk/s3-request-presigner": "^3.1156.0",
		"argon2": "^0.45.1",
		"axios": "^1.20.0",
		"compression": "^1.8.1",
		"cookie-parser": "^1.4.7",
		"cors": "^2.8.6",
		"dotenv": "^17.4.2",
		"drizzle-orm": "^0.45.2",
		"express": "^5.3.0",
		"express-rate-limit": "^8.7.1",
		"helmet": "^8.3.0",
		"jose": "^6.2.13",
		"multer": "^2.5.0",
		"pino": "^10.3.1",
		"pino-http": "^11.0.0",
		"postgres": "^3.4.9",
		"redis": "^6.3.0",
		"resend": "^6.34.1",
		"supertest": "^7.2.2",
		"zod": "^4.4.3"
	}
}
