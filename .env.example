# Environment | Local, Development, Test, Staging, Production
NODE_ENV=local

# Port | The port the server will listen on
PORT=3000

# Host | The host the server will listen on
HOST=0.0.0.0

# Base URL | The public base URL of the API
BASE_URL=http://localhost:3000

# Frontend Base URL | Public web app origin (emails, redirects, deep links)
FRONTEND_BASE_URL=http://localhost:5173

# App Name | Display name in transactional emails
APP_NAME=Node Express Starter

# CORS Origins | The origins that are allowed to access the API
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Log Level | The level of logging to use | trace, debug, info, warn, error, fatal, silent
LOG_LEVEL=debug

# Trust Proxy | false/true, or a non-negative hop count (e.g. 1)
TRUST_PROXY=false

# Rate Limit Window | The window size in milliseconds
RATE_LIMIT_WINDOW_MS=60000

# Rate Limit Max Requests | Max requests allowed per window
RATE_LIMIT_MAX_REQUESTS=100

# Cookies Secret | The secret used to sign cookies (min 32 characters)
COOKIES_SECRET=test-cookies-secret-at-least-32-chars

# Auth JWT | Access-token signing (HS256); refresh tokens are opaque DB-backed hashes
AUTH_JWT_SECRET=test-auth-jwt-secret-at-least-32-chars
AUTH_JWT_ISSUER=api
AUTH_JWT_AUDIENCE=api
AUTH_ACCESS_TOKEN_TTL_SECONDS=600
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH_ACCOUNT_DELETION_GRACE_DAYS=14
AUTH_OAUTH_STATE_TTL_SECONDS=600

# OAuth | Set a provider client id to enable GET /auth/oauth/{provider}/authorize
# FRONTEND_BASE_URL origin is always allowed; add extra exact URIs (mobile deep links) here
OAUTH_REDIRECT_URIS=
# OAUTH_GOOGLE_CLIENT_ID=
# OAUTH_GOOGLE_CLIENT_SECRET=
# OAUTH_GITHUB_CLIENT_ID=
# OAUTH_GITHUB_CLIENT_SECRET=
# OAUTH_APPLE_CLIENT_ID=
# OAUTH_APPLE_CLIENT_SECRET=
# OAUTH_MICROSOFT_CLIENT_ID=
# OAUTH_MICROSOFT_CLIENT_SECRET=
# OAUTH_OIDC_CLIENT_ID=
# OAUTH_OIDC_CLIENT_SECRET=
# OAUTH_OIDC_AUTHORIZATION_URL=
# OAUTH_OIDC_TOKEN_URL=
# OAUTH_OIDC_USERINFO_URL=
# OAUTH_OIDC_ISSUER=
# OAUTH_OIDC_SCOPES=openid email profile

# Background jobs | bullmq (API producer + worker) | noop (tests)
JOBS_PROVIDER=bullmq
JOBS_PREFIX=neca
JOBS_QUEUE_NAME=default
JOBS_CONCURRENCY=5
JOBS_ATTEMPTS=5
JOBS_ACCOUNT_DELETION_SWEEP_CRON=*/15 * * * *
# Local Bull Board only (`pnpm jobs:ui`); keep 127.0.0.1 — not mounted on the API
JOBS_DASHBOARD_HOST=127.0.0.1
JOBS_DASHBOARD_PORT=3010

# Database URL | The URL of the database to use
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/node_express_clean_architecture

# Redis URL | The URL of the Redis instance to use
REDIS_URL=redis://localhost:6379

# Email Provider | resend | noop
EMAIL_PROVIDER=noop

# Default From Address | Required when EMAIL_PROVIDER=resend
EMAIL_FROM=noreply@example.com

# Default From Name | Optional display name for the from address
EMAIL_FROM_NAME=Node Express Starter

# Resend API Key | Required when EMAIL_PROVIDER=resend
RESEND_API_KEY=

# Outbound HTTP client (Axios-backed IHttpClient)
HTTP_CLIENT_TIMEOUT_MS=10000
HTTP_CLIENT_MAX_RETRIES=2
HTTP_CLIENT_RETRY_BASE_DELAY_MS=200

# HTTP server timeouts (Node http.Server) | headers must be > keep-alive
HTTP_SERVER_REQUEST_TIMEOUT_MS=30000
HTTP_SERVER_HEADERS_TIMEOUT_MS=70000
HTTP_SERVER_KEEP_ALIVE_TIMEOUT_MS=65000

# Storage Provider | local | s3
STORAGE_PROVIDER=local

# Local storage directory | Used when STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./uploads

# Public base URL for objects | Optional (CDN / public bucket / local static URL)
# STORAGE_PUBLIC_BASE_URL=https://cdn.example.com

# S3 settings | Required when STORAGE_PROVIDER=s3
# STORAGE_BUCKET=my-bucket
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=
# STORAGE_REGION=us-east-1
# STORAGE_ENDPOINT=
# STORAGE_FORCE_PATH_STYLE=false
